# Copiar a .env (NO subir a GitHub). La clave debe tener 16+ caracteres.
FC_ADMIN_PASSWORD=CAMBIA_ESTO_POR_UNA_CLAVE_MUY_LARGA

# Correo de destino para avisos de sesión caducada.
ALERT_EMAIL_TO=

# SMTP, por ejemplo Gmail: smtp.gmail.com / 587 / email / contraseña de aplicación.
# Para Gmail normalmente hay que habilitar la verificación en dos pasos
# y crear una contraseña de aplicación si la cuenta lo permite.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
